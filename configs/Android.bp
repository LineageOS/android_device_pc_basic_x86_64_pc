prebuilt_etc {
    name: "fstab.basic_x86_64_pc",
    src: "fstab.basic_x86_64_pc",
    vendor: true,
    ramdisk_available: true,
}

prebuilt_etc {
    name: "init.basic_x86_64_pc.rc",
    src: "init.basic_x86_64_pc.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.basic_x86_64_pc.rc",
    src: "init.recovery.basic_x86_64_pc.rc",
    sub_dir: "init",
    recovery: true,
}
