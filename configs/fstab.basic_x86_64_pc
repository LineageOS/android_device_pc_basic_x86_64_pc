# Base
/dev/block/by-name/base /oem ext4 defaults first_stage_mount
/dev/block/by-name/base /oem f2fs defaults first_stage_mount
/dev/block/by-name/base /oem vfat defaults first_stage_mount

# Metadata
/oem/android/metadata /metadata none bind latemount

# System
/oem/android/system.img /system ext4 noatime,ro first_stage_mount

# Userdata
/oem/android/data /data none bind latemount

# Vendor
/oem/android/vendor.img /vendor ext4 noatime,ro first_stage_mount

# External
/devices/*/usb* auto auto defaults voldmanaged=usb:auto
