# Base
/dev/block/by-name/base /base ext4 defaults first_stage_mount
/dev/block/by-name/base /base f2fs defaults first_stage_mount
/dev/block/by-name/base /base vfat defaults first_stage_mount

# Metadata
/base/android/metadata /metadata none bind first_stage_mount

# System
/base/android/system.img /system ext4 defaults first_stage_mount

# Userdata
/base/android/data /data none bind latemount

# Vendor
/base/android/vendor.img /vendor ext4 defaults first_stage_mount

# External
/devices/*/usb* auto auto defaults voldmanaged=usb:auto
